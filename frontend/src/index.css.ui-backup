@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --erp-background: #f4f7fb;

  --erp-surface: #ffffff;

  --erp-sidebar: #0f172a;

  --erp-sidebar-hover: #1e293b;

  --erp-border: #e2e8f0;

  --erp-text-primary: #111827;

  --erp-text-secondary: #64748b;

  --erp-accent: #2563eb;

  --erp-shadow:
    0 10px 30px rgba(15, 23, 42, 0.08);

  --erp-radius: 24px;
}

/* GLOBAL APP STYLING */

body {
  background: var(--erp-background);

  color: var(--erp-text-primary);

  @apply antialiased;
}

/* SCROLLBAR */

::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}

::-webkit-scrollbar-track {background: #f3f4f6;
}

::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 9999px;
}

.erp-card {
  background: var(--erp-surface);

  border: 1px solid var(--erp-border);

  border-radius: var(--erp-radius);

  box-shadow: var(--erp-shadow);

  @apply p-6;
}

/* REUSABLE SECTION */

.erp-section {
  @apply p-6;
}

/* REUSABLE TABLE */

.erp-table-container {
  @apply bg-white rounded-3xl border border-gray-200 shadow-sm overflow-hidden;
}

.erp-table thead tr {
  @apply border-b border-gray-200;
}

.erp-table tbody tr {
  @apply hover:bg-gray-50 transition;
}

.erp-table-scroll {
  @apply overflow-auto max-h-[70vh];
}

.erp-table {
  @apply w-full border-collapse;
}

.erp-table thead {
  @apply sticky top-0 z-10 bg-white;
}

.erp-table thead tr {
  @apply border-b border-gray-200;
}

.erp-table th {
  @apply text-left text-sm font-bold text-gray-700 px-6 py-4 whitespace-nowrap bg-white;
}

.erp-table td {
  @apply px-6 py-4 border-b border-gray-100 text-sm text-gray-700 whitespace-nowrap;
}

/* REUSABLE BUTTONS */

.erp-button-primary {
  @apply bg-black text-white px-5 py-3 rounded-xl font-semibold shadow-sm hover:bg-gray-900 transition-all duration-200;
}

.erp-button-danger {
  @apply bg-red-600 text-white px-5 py-3 rounded-xl font-semibold shadow-sm hover:bg-red-700 transition-all duration-200;
}

/* REUSABLE INPUTS */

.erp-input {
  @apply w-full border border-gray-300 rounded-xl px-4 py-3 bg-white focus:outline-none focus:ring-2 focus:ring-black transition;
}

.erp-select {
  @apply w-full border border-gray-300 rounded-xl px-4 py-3 bg-white focus:outline-none focus:ring-2 focus:ring-black transition;
}

/* PAGE TITLES */

.erp-page-title {
  @apply text-4xl font-black text-gray-900;
}

.erp-page-description {
  @apply text-gray-500 mt-2 mb-8;
}

/* STATUS BADGES */

.erp-badge-success {
  @apply inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-700;
}

.erp-badge-danger {
  @apply inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-700;
}

.erp-badge-warning {
  @apply inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-yellow-100 text-yellow-700;
}

/* ANIMATIONS */

.erp-hover-lift {
  @apply transition-all duration-200 hover:-translate-y-1 hover:shadow-lg;
}

/* SIDEBAR SCROLLBAR */

.sidebar-scroll {
  scrollbar-width: thin;
  scrollbar-color: #1e293b transparent;
}

.sidebar-scroll::-webkit-scrollbar {
  width: 6px;
}

.sidebar-scroll::-webkit-scrollbar-track {
  background: transparent;
}

.sidebar-scroll::-webkit-scrollbar-thumb {
  background: #1e293b;
  border-radius: 9999px;
}

.sidebar-scroll::-webkit-scrollbar-thumb:hover {
  background: #334155;
}

/* =========================
   MODERN ERP LAYOUT HELPERS
========================= */

.erp-page-grid {
  display: grid;
  grid-template-columns: repeat(1, minmax(0, 1fr));
  gap: 1.25rem;
}

@media (min-width: 1024px) {
  .erp-page-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

.erp-stat-card {
  border: 1px solid #e2e8f0;
  background: #ffffff;
  border-radius: 1rem;
  padding: 1.25rem;
  box-shadow: 0 4px 18px rgba(15, 23, 42, 0.05);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.erp-stat-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
}

.erp-primary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border-radius: 0.75rem;
  padding: 0.625rem 1rem;
  font-weight: 600;
  transition: all 0.2s ease;
}

.erp-primary-button:focus-visible {
  outline: 2px solid #3b82f6;
  outline-offset: 2px;
}


/* =========================
   ERP STATES
========================= */

.erp-empty-state {
  display: flex;
  min-height: 180px;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 0.5rem;
  border: 1px dashed #cbd5e1;
  border-radius: 1rem;
  background: #f8fafc;
  color: #64748b;
  padding: 2rem;
  text-align: center;
}

.erp-loading {
  display: flex;
  min-height: 180px;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-size: 0.875rem;
}

.erp-badge {
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  padding: 0.25rem 0.65rem;
  font-size: 0.7rem;
  font-weight: 700;
}


/* =========================
   ERP MODALS
========================= */

.erp-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  background: rgba(15, 23, 42, 0.55);
  backdrop-filter: blur(4px);
}

.erp-modal {
  width: 100%;
  max-width: 640px;
  max-height: calc(100vh - 2rem);
  overflow-y: auto;
  border: 1px solid #e2e8f0;
  border-radius: 1.25rem;
  background: #ffffff;
  box-shadow: 0 24px 60px rgba(15, 23, 42, 0.2);
}

.erp-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid #e2e8f0;
}

.erp-modal-body {
  padding: 1.5rem;
}

.erp-modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 0.75rem;
  padding: 1rem 1.5rem;
  border-top: 1px solid #e2e8f0;
  background: #f8fafc;
}


/* =========================
   ERP SCROLLBARS
========================= */

.erp-scrollbar {
  scrollbar-width: thin;
  scrollbar-color: #cbd5e1 transparent;
}

.erp-scrollbar::-webkit-scrollbar {
  width: 7px;
  height: 7px;
}

.erp-scrollbar::-webkit-scrollbar-track {
  background: transparent;
}

.erp-scrollbar::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 999px;
}

.erp-scrollbar::-webkit-scrollbar-thumb:hover {
  background: #94a3b8;
}

/* =========================
   RESPONSIVE ERP SPACING
========================= */

@media (max-width: 640px) {
  .erp-card {
    border-radius: 0.875rem;
  }

  .erp-table-container {
    overflow-x: auto;
  }

  .erp-stat-card {
    padding: 1rem;
  }
}


/* =========================
   ERP ACCESSIBILITY / FOCUS
========================= */

.erp-focus-ring:focus-visible {
  outline: 2px solid #3b82f6;
  outline-offset: 2px;
}

button:focus-visible,
a:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline: 2px solid #3b82f6;
  outline-offset: 2px;
}

/* =========================
   ERP TRANSITIONS
========================= */

.erp-transition {
  transition:
    background-color 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease,
    box-shadow 0.2s ease,
    transform 0.2s ease;
}


/* =========================
   ERP SURFACE UTILITIES
========================= */

.erp-divider {
  height: 1px;
  width: 100%;
  background: #e2e8f0;
}

.erp-muted {
  color: #64748b;
}

.erp-icon-box {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 0.75rem;
  background: #f1f5f9;
  color: #334155;
}

.erp-action-group {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}


/* =========================
   ERP PAGE TOOLBAR
========================= */

.erp-page-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 1.5rem;
}

.erp-page-toolbar-actions {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.erp-secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border: 1px solid #cbd5e1;
  border-radius: 0.75rem;
  background: #ffffff;
  color: #334155;
  padding: 0.625rem 1rem;
  font-size: 0.875rem;
  font-weight: 600;
  transition: all 0.2s ease;
}

.erp-secondary-button:hover {
  background: #f8fafc;
  border-color: #94a3b8;
}

.erp-danger-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border-radius: 0.75rem;
  background: #dc2626;
  color: #ffffff;
  padding: 0.625rem 1rem;
  font-size: 0.875rem;
  font-weight: 600;
  transition: all 0.2s ease;
}

.erp-danger-button:hover {
  background: #b91c1c;
}


/* =========================
   ERP PAGINATION
========================= */

.erp-pagination {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  flex-wrap: wrap;
  padding: 1rem 0;
  color: #64748b;
  font-size: 0.875rem;
}

.erp-pagination-actions {
  display: flex;
  align-items: center;
  gap: 0.35rem;
}

.erp-pagination-button {
  min-width: 2.25rem;
  height: 2.25rem;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #e2e8f0;
  border-radius: 0.65rem;
  background: #ffffff;
  color: #475569;
  font-weight: 600;
  transition: all 0.2s ease;
}

.erp-pagination-button:hover:not(:disabled) {
  background: #f8fafc;
  border-color: #cbd5e1;
}

.erp-pagination-button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.erp-pagination-button.active {
  background: #2563eb;
  border-color: #2563eb;
  color: #ffffff;
}


/* =========================
   ERP NOTIFICATIONS
========================= */

.erp-toast {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  width: min(420px, calc(100vw - 2rem));
  padding: 0.9rem 1rem;
  border: 1px solid #e2e8f0;
  border-radius: 0.9rem;
  background: #ffffff;
  box-shadow: 0 12px 30px rgba(15, 23, 42, 0.12);
}

.erp-toast-success {
  border-color: #bbf7d0;
  background: #f0fdf4;
}

.erp-toast-error {
  border-color: #fecaca;
  background: #fef2f2;
}

.erp-toast-warning {
  border-color: #fde68a;
  background: #fffbeb;
}

.erp-toast-info {
  border-color: #bfdbfe;
  background: #eff6ff;
}


/* =========================
   ERP STATUS INDICATORS
========================= */

.erp-status {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  border-radius: 999px;
  padding: 0.3rem 0.7rem;
  font-size: 0.7rem;
  font-weight: 700;
  line-height: 1;
}

.erp-status::before {
  content: "";
  width: 0.4rem;
  height: 0.4rem;
  border-radius: 999px;
  background: currentColor;
}

.erp-status-success {
  color: #15803d;
  background: #dcfce7;
}

.erp-status-warning {
  color: #a16207;
  background: #fef9c3;
}

.erp-status-danger {
  color: #b91c1c;
  background: #fee2e2;
}

.erp-status-info {
  color: #1d4ed8;
  background: #dbeafe;
}

.erp-status-neutral {
  color: #475569;
  background: #f1f5f9;
}


/* =========================================================
   ERP UI — CONSOLIDATED MODERN DESIGN SYSTEM
========================================================= */

.erp-surface {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 1rem;
  box-shadow: 0 4px 18px rgba(15, 23, 42, 0.05);
}

.erp-card {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 1rem;
  box-shadow: 0 4px 18px rgba(15, 23, 42, 0.05);
  transition: box-shadow 0.2s ease, transform 0.2s ease;
}

.erp-card:hover {
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
}

.erp-page-title {
  color: #0f172a;
  font-size: 1.875rem;
  line-height: 2.25rem;
  font-weight: 800;
  letter-spacing: -0.025em;
}

.erp-page-description {
  margin-top: 0.35rem;
  color: #64748b;
  font-size: 0.875rem;
  line-height: 1.25rem;
}

.erp-section-title {
  color: #0f172a;
  font-size: 1rem;
  line-height: 1.5rem;
  font-weight: 700;
}

/* Forms */

.erp-input,
.erp-select,
.erp-textarea {
  width: 100%;
  min-height: 42px;
  border: 1px solid #cbd5e1;
  border-radius: 0.75rem;
  background: #ffffff;
  color: #0f172a;
  padding: 0.625rem 0.8rem;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.erp-input:focus,
.erp-select:focus,
.erp-textarea:focus {
  outline: none;
  border-color: #3b82f6;
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
}

.erp-label {
  display: block;
  margin-bottom: 0.4rem;
  color: #475569;
  font-size: 0.75rem;
  font-weight: 700;
}

/* Buttons */

.erp-primary-button,
.erp-secondary-button,
.erp-danger-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  min-height: 40px;
  border-radius: 0.75rem;
  padding: 0.625rem 1rem;
  font-size: 0.875rem;
  font-weight: 600;
  transition: all 0.2s ease;
}

.erp-primary-button {
  background: #2563eb;
  color: #ffffff;
  border: 1px solid #2563eb;
}

.erp-primary-button:hover {
  background: #1d4ed8;
  border-color: #1d4ed8;
}

.erp-secondary-button {
  background: #ffffff;
  color: #334155;
  border: 1px solid #cbd5e1;
}

.erp-secondary-button:hover {
  background: #f8fafc;
}

.erp-danger-button {
  background: #dc2626;
  color: #ffffff;
  border: 1px solid #dc2626;
}

.erp-danger-button:hover {
  background: #b91c1c;
}

/* Search / filters */

.erp-search-bar {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
  padding: 1rem;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 1rem;
}

.erp-search {
  flex: 1 1 240px;
  min-width: 0;
  min-height: 42px;
  border: 1px solid #cbd5e1;
  border-radius: 0.75rem;
  padding: 0.625rem 0.8rem;
}

.erp-filter {
  min-height: 42px;
  border: 1px solid #cbd5e1;
  border-radius: 0.75rem;
  background: #ffffff;
  padding: 0.625rem 0.8rem;
}

/* Tables */

.erp-table-container {
  overflow: hidden;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 1rem;
}

.erp-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
}

.erp-table thead th {
  background: #f8fafc;
  color: #475569;
  padding: 0.85rem 1rem;
  border-bottom: 1px solid #e2e8f0;
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  white-space: nowrap;
}

.erp-table tbody td {
  padding: 0.85rem 1rem;
  border-bottom: 1px solid #f1f5f9;
  color: #334155;
  font-size: 0.875rem;
}

.erp-table tbody tr:hover {
  background: #f8fafc;
}

.erp-table tbody tr:last-child td {
  border-bottom: 0;
}

/* Status */

.erp-status,
.erp-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  border-radius: 999px;
  padding: 0.3rem 0.7rem;
  font-size: 0.7rem;
  font-weight: 700;
}

.erp-status-success {
  color: #15803d;
  background: #dcfce7;
}

.erp-status-warning {
  color: #a16207;
  background: #fef9c3;
}

.erp-status-danger {
  color: #b91c1c;
  background: #fee2e2;
}

.erp-status-info {
  color: #1d4ed8;
  background: #dbeafe;
}

.erp-status-neutral {
  color: #475569;
  background: #f1f5f9;
}

/* Empty / loading */

.erp-empty-state {
  display: flex;
  min-height: 180px;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 0.5rem;
  padding: 2rem;
  border: 1px dashed #cbd5e1;
  border-radius: 1rem;
  background: #f8fafc;
  color: #64748b;
  text-align: center;
}

.erp-loading {
  display: flex;
  min-height: 180px;
  align-items: center;
  justify-content: center;
  color: #64748b;
}

/* Modals */

.erp-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  background: rgba(15, 23, 42, 0.55);
  backdrop-filter: blur(4px);
}

.erp-modal {
  width: 100%;
  max-width: 640px;
  max-height: calc(100vh - 2rem);
  overflow-y: auto;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 1.25rem;
  box-shadow: 0 24px 60px rgba(15, 23, 42, 0.2);
}

/* Toolbar */

.erp-page-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
  margin-bottom: 1.5rem;
}

.erp-action-group {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}

/* Stats */

.erp-stat-card {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 1rem;
  padding: 1.25rem;
  box-shadow: 0 4px 18px rgba(15, 23, 42, 0.05);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.erp-stat-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
}

/* Responsive */

@media (max-width: 768px) {
  .erp-page-title {
    font-size: 1.5rem;
    line-height: 2rem;
  }

  .erp-page-toolbar {
    align-items: flex-start;
  }

  .erp-table-container {
    overflow-x: auto;
  }

  .erp-search-bar {
    align-items: stretch;
    flex-direction: column;
  }

  .erp-search,
  .erp-filter {
    width: 100%;
  }
}


/* =========================================================
   ERP RESPONSIVE PASS
========================================================= */

.erp-responsive-grid {
  display: grid;
  grid-template-columns: repeat(1, minmax(0, 1fr));
  gap: 1rem;
}

.erp-responsive-actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  flex-wrap: wrap;
}

.erp-table-scroll {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.erp-table-scroll table {
  min-width: 720px;
}

.erp-content-scroll {
  width: 100%;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

@media (min-width: 768px) {
  .erp-responsive-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (min-width: 1280px) {
  .erp-responsive-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 640px) {
  .erp-responsive-actions {
    width: 100%;
    flex-direction: column;
    align-items: stretch;
  }

  .erp-responsive-actions > button,
  .erp-responsive-actions > a {
    width: 100%;
  }

  .erp-modal {
    max-height: calc(100vh - 1rem);
    border-radius: 1rem;
  }

  .erp-stat-card {
    padding: 1rem;
  }

  .erp-card {
    border-radius: 0.875rem;
  }
}


/* =========================================================
   ERP INTERACTION + ACCESSIBILITY PASS
========================================================= */

.erp-transition {
  transition:
    background-color 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease,
    box-shadow 0.2s ease,
    transform 0.2s ease;
}

.erp-icon-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.25rem;
  height: 2.25rem;
  border: 1px solid #e2e8f0;
  border-radius: 0.65rem;
  background: #ffffff;
  color: #475569;
  transition: all 0.2s ease;
}

.erp-icon-button:hover {
  background: #f8fafc;
  border-color: #cbd5e1;
  color: #0f172a;
}

.erp-icon-box {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 0.75rem;
  background: #f1f5f9;
  color: #334155;
}

.erp-divider {
  width: 100%;
  height: 1px;
  background: #e2e8f0;
}

.erp-muted {
  color: #64748b;
}

.erp-scrollbar {
  scrollbar-width: thin;
  scrollbar-color: #cbd5e1 transparent;
}

.erp-scrollbar::-webkit-scrollbar {
  width: 7px;
  height: 7px;
}

.erp-scrollbar::-webkit-scrollbar-track {
  background: transparent;
}

.erp-scrollbar::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 999px;
}

.erp-scrollbar::-webkit-scrollbar-thumb:hover {
  background: #94a3b8;
}

.erp-primary-button:focus-visible,
.erp-secondary-button:focus-visible,
.erp-danger-button:focus-visible,
.erp-icon-button:focus-visible,
.erp-input:focus-visible,
.erp-select:focus-visible,
.erp-textarea:focus-visible {
  outline: 2px solid #2563eb;
  outline-offset: 2px;
}
