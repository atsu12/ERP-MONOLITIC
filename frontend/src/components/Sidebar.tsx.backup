import {
  Link,
  useLocation,
  useNavigate,
} from "react-router-dom";

import { useAuthStore } from "../store/authStore";
import {
  Menu,
  X,
  LayoutDashboard,
  Package,
  Boxes,
  PackageMinus,
  ScanLine,
  ArrowLeftRight,
  Activity,
  Warehouse,
  FileText,
  Users,
  SlidersHorizontal,
  Wallet,
  UserCog,
  LogOut,
} from "lucide-react";

import { useLayoutStore } from "../store/layoutStore";
import logo from "../assets/logo.png";

function Sidebar() {
  const navigate = useNavigate();
  const location = useLocation();

  const user = useAuthStore((state) => state.user);
  const logout = useAuthStore((state) => state.logout);

  const {
    sidebarCollapsed,
    mobileMenuOpen,
    toggleSidebar,
    closeMobileMenu,
  } = useLayoutStore();

  const navSections = [
    {
      title: "INVENTORY",
      items: [
        {
          label: "Dashboard",
          path: "/dashboard",
          icon: LayoutDashboard,
          roles: ["ADMIN", "MANAGER", "STAFF"],
        },
        {
          label: "Products",
          path: "/products",
          icon: Package,
          roles: ["ADMIN", "MANAGER", "STAFF"],
        },
        {
          label: "Stock In",
          path: "/stock-in",
          icon: Boxes,
          roles: ["ADMIN", "MANAGER", "STAFF"],
        },
        {
          label: "Stock Out",
          path: "/stock-out",
          icon: PackageMinus,
          roles: ["ADMIN", "MANAGER", "STAFF"],
        },
        {
          label: "Warehouses",
          path: "/warehouses",
          icon: Warehouse,
          roles: ["ADMIN"],
        },
        {
          label: "Scan Inventory",
          path: "/scan",
          icon: ScanLine,
          roles: ["ADMIN", "MANAGER", "STAFF"],
        },
      ],
    },

    {
      title: "OPERATIONS",
      items: [
        {
          label: "Movements",
          path: "/movements",
          icon: ArrowLeftRight,
          roles: ["ADMIN", "MANAGER"],
        },
        {
          label: "Activity Logs",
          path: "/activity",
          icon: Activity,
          roles: ["ADMIN"],
        },
        {
          label: "Cashier",
          path: "/cashier",
          icon: Wallet,
          roles: ["ADMIN", "MANAGER", "STAFF"],
        },
      ],
    },

    {
      title: "ANALYTICS",
      items: [
        {
          label: "Reports",
          path: "/reports",
          icon: FileText,
          roles: ["ADMIN", "MANAGER"],
        },
      ],
    },

    {
      title: "ADMINISTRATION",
      items: [
        {
          label: "Customers",
          path: "/customers",
          icon: Users,
          roles: ["ADMIN", "MANAGER", "STAFF"],
        },
        {
          label: "Users",
          path: "/users",
          icon: Users,
          roles: ["ADMIN"],
        },
        {
          label: "Settings",
          path: "/adjustments",
          icon: SlidersHorizontal,
          roles: ["ADMIN"],
        },
      ],
    },
  ];

  const handleLogout = () => {
    logout();
    navigate("/login");
  };

  return (
    <aside
      className={`fixed left-0 top-0 z-40 flex h-screen flex-col overflow-hidden border-r border-slate-800 bg-[#081426] text-white shadow-2xl transition-all duration-300 ${
        mobileMenuOpen
          ? "translate-x-0"
          : "-translate-x-full lg:translate-x-0"
      } ${
        sidebarCollapsed
          ? "w-[84px]"
          : "w-[252px]"
      }`}
    >
      <div className="flex h-full min-h-0 flex-col">
        <div className="flex h-[84px] shrink-0 items-center border-b border-slate-800/80 px-5">
          {sidebarCollapsed ? (
            <img
              src={logo}
              alt="ZICO STOCK"
              className="mx-auto h-10 w-10 object-contain"
            />
          ) : (
            <div className="flex items-center gap-3">
              <img
                src={logo}
                alt="ZICO STOCK"
                className="h-11 w-11 object-contain"
              />

              <div>
                <h1 className="text-[20px] font-extrabold tracking-tight">
                  ZICO STOCK
                </h1>

                <p className="mt-0.5 text-[11px] text-slate-400">
                  Warehouse ERP
                </p>
              </div>
            </div>
          )}

          <button
            onClick={() => {
              if (window.innerWidth < 1024) {
                closeMobileMenu();
              } else {
                toggleSidebar();
              }
            }}
            className="ml-auto hidden rounded-lg p-2 text-slate-400 transition hover:bg-slate-800 hover:text-white lg:block"
          >
            {window.innerWidth < 1024 ? (
              <X size={18} />
            ) : (
              <Menu size={18} />
            )}
          </button>
        </div>

        <div className="erp-sidebar-scroll min-h-0 flex-1 overflow-y-auto px-3 py-5">
          <nav className="space-y-7">
            {navSections.map((section) => {
              const visibleItems =
                section.items.filter((item) =>
                  item.roles.includes(
                    user?.role,
                  ),
                );

              if (!visibleItems.length) {
                return null;
              }

              return (
                <div key={section.title}>
                  {!sidebarCollapsed && (
                    <p className="mb-2 px-3 text-[10px] font-bold tracking-[0.16em] text-slate-500">
                      {section.title}
                    </p>
                  )}

                  <div className="space-y-1">
                    {visibleItems.map((item) => {
                      const Icon = item.icon;
                      const active =
                        location.pathname ===
                        item.path;

                      return (
                        <Link
                          key={item.path}
                          to={item.path}
                          onClick={
                            closeMobileMenu
                          }
                          title={
                            sidebarCollapsed
                              ? item.label
                              : undefined
                          }
                          className={`group flex items-center rounded-xl px-3 py-2.5 text-[13px] font-semibold transition-all ${
                            sidebarCollapsed
                              ? "justify-center"
                              : "gap-3"
                          } ${
                            active
                              ? "bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-lg shadow-blue-950/30"
                              : "text-slate-300 hover:bg-slate-800/80 hover:text-white"
                          }`}
                        >
                          <Icon
                            size={
                              sidebarCollapsed
                                ? 21
                                : 18
                            }
                            strokeWidth={
                              active ? 2.2 : 1.9
                            }
                          />

                          {!sidebarCollapsed && (
                            <>
                              <span className="flex-1">
                                {item.label}
                              </span>

                              {active && (
                                <span className="h-1.5 w-1.5 rounded-full bg-white" />
                              )}
                            </>
                          )}
                        </Link>
                      );
                    })}
                  </div>
                </div>
              );
            })}
          </nav>
        </div>

        <div className="shrink-0 border-t border-slate-800/80 p-3">
          <button
            onClick={() =>
              navigate("/my-account")
            }
            className={`mb-2 flex w-full items-center rounded-xl border border-slate-800 bg-slate-900/70 p-2.5 transition hover:border-slate-700 hover:bg-slate-800 ${
              sidebarCollapsed
                ? "justify-center"
                : "gap-3"
            }`}
          >
            <span className="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-violet-500 to-indigo-600 font-bold text-white">
              {(user?.username || "U")
                .charAt(0)
                .toUpperCase()}
            </span>

            {!sidebarCollapsed && (
              <span className="min-w-0 text-left">
                <strong className="block truncate text-xs font-bold text-white">
                  {user?.username || "User"}
                </strong>

                <small className="block truncate text-[10px] text-slate-400">
                  {user?.role || "Administrator"}
                </small>
              </span>
            )}
          </button>

          <button
            onClick={handleLogout}
            className={`flex w-full items-center rounded-xl px-3 py-2.5 text-xs font-semibold text-slate-400 transition hover:bg-red-500/10 hover:text-red-300 ${
              sidebarCollapsed
                ? "justify-center"
                : "gap-3"
            }`}
          >
            <LogOut size={17} />

            {!sidebarCollapsed && "Logout"}
          </button>
        </div>
      </div>
    </aside>
  );
}

export default Sidebar;
