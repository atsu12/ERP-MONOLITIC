const bcrypt = require("bcrypt");
const logger = require("../utils/logger");

const db = require("../configs/db").promise();

const getSetupStatus = async (req, res) => {
  try {
    const [[userResult]] = await db.query(`
      SELECT COUNT(*) AS total
      FROM users
    `);

    const [[settingsResult]] = await db.query(`
      SELECT setup_completed
      FROM settings
      WHERE id = 1
      LIMIT 1
    `);

    const initialized =
      userResult.total > 0 &&
      settingsResult &&
      Number(settingsResult.setup_completed) === 1;

    res.json({
      initialized,
    });
  } catch (error) {
    logger.error(`Setup status error: ${error.message}`);

    res.status(500).json({
      message: "Failed to check setup status",
    });
  }
};

const createFirstAdmin = async (req, res) => {
  const connection = await db.getConnection();

  try {
    const {
      username,
      telephone,
      password,
      base_currency,
      display_currency,
      currency_symbol,
      usd_exchange_rate,
      company_multiplier,
    } = req.body;

    if (
      !username ||
      !telephone ||
      !password ||
      !base_currency ||
      !display_currency ||
      !currency_symbol ||
      usd_exchange_rate === undefined ||
      usd_exchange_rate === null ||
      company_multiplier === undefined ||
      company_multiplier === null
    ) {
      return res.status(400).json({
        message: "All setup fields are required",
      });
    }

    const exchangeRate = Number(usd_exchange_rate);
    const multiplier = Number(company_multiplier);

    if (!Number.isFinite(exchangeRate) || exchangeRate <= 0) {
      return res.status(400).json({
        message: "USD exchange rate must be greater than 0",
      });
    }

    if (!Number.isFinite(multiplier) || multiplier <= 0) {
      return res.status(400).json({
        message: "Company multiplier must be greater than 0",
      });
    }

    await connection.beginTransaction();

    const [[userResult]] = await connection.query(`
      SELECT COUNT(*) AS total
      FROM users
    `);

    const [[settingsResult]] = await connection.query(`
      SELECT setup_completed
      FROM settings
      WHERE id = 1
      LIMIT 1
    `);

    if (
      userResult.total > 0 ||
      !settingsResult ||
      Number(settingsResult.setup_completed) === 1
    ) {
      await connection.rollback();

      return res.status(403).json({
        message: "System already initialized",
      });
    }

    const password_hash = await bcrypt.hash(password, 10);

    await connection.query(
      `
        INSERT INTO users (
          username,
          telephone,
          password_hash,
          role
        )
        VALUES (?, ?, ?, 'ADMIN')
      `,
      [username, telephone, password_hash]
    );

    await connection.query(
      `
        UPDATE settings
        SET
          base_currency = ?,
          display_currency = ?,
          currency_symbol = ?,
          usd_exchange_rate = ?,
          company_multiplier = ?,
          setup_completed = 1
        WHERE id = 1
      `,
      [
        base_currency,
        display_currency,
        currency_symbol,
        exchangeRate,
        multiplier,
      ]
    );

    await connection.commit();

    res.status(201).json({
      message: "Administrator account and system setup completed successfully",
    });
  } catch (error) {
    await connection.rollback();

    logger.error(`Admin setup error: ${error.message}`);

    res.status(500).json({
      message: "Failed to complete system setup",
    });
  } finally {
    connection.release();
  }
};

module.exports = {
  getSetupStatus,
  createFirstAdmin,
};
